{
  "name": "onboarding-automations",
  "private": true,
  "description": "Agent Skills for Microsoft employee onboarding. Zero runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs \"tests/**/*.test.mjs\"",
    "test:unit": "node scripts/run-tests.mjs \"tests/**/!(*.integration).test.mjs\"",
    "test:property": "node scripts/run-tests.mjs tests/quality/property.test.mjs",
    "test:contracts": "node scripts/run-tests.mjs tests/quality/contracts.test.mjs",
    "test:mutation": "node scripts/mutation-gate.mjs --threshold 70",
    "test:crap": "node scripts/crap-gate.mjs --threshold 30",
    "test:quality": "npm run test:property && npm run test:contracts && npm run test:mutation && npm run test:crap",
    "bench": "node tests/request-new-azure-subscription/bench.mjs 5"
  },
  "devDependencies": {
    "acorn": "8.19.0"
  }
}
